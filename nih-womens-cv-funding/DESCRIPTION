Package: nih.womens.cv.funding
Title: Temporal Trends in NIH Funding for Women's Cardiovascular Health Research: Reproduction Code
Version: 1.0.0
Description: Annotated R pipeline that reproduces every number and figure of the
    accompanying brief report from public NIH RePORTER/ExPORTER records (plus NASEM committee
    workbooks for FY2013-2023). Not an installable package; this file records the
    R and CRAN package versions used (install with
    install.packages(c("data.table", "stringi", "readxl", "jsonlite", "curl", "sandwich",
    "ggplot2", "openxlsx", "ragg", "systemfonts"))).
License: MIT + file LICENSE
Depends: R (>= 4.5.0)
Imports:
    data.table (>= 1.17.0),
    stringi (>= 1.8.4),
    readxl (>= 1.4.5),
    jsonlite (>= 1.9.1),
    curl (>= 6.2.1),
    sandwich (>= 3.1.1),
    ggplot2 (>= 3.5.1),
    openxlsx (>= 4.2.8),
    ragg (>= 1.3.3),
    systemfonts (>= 1.2.1)
Encoding: UTF-8
